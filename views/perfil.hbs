<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/css/perfil.css">
  <title>Perfil</title>
</head>
<body>
  <div class="perfil">
    <ul>
      <li><strong>Nombre:</strong> <span id="nombre"></span></li>
      <li><strong>Apellido:</strong> <span id="apellido"></span></li>
      <li><strong>Correo:</strong> <span id="correo"></span></li>
      <li><strong>Fecha de nacimiento:</strong> <span id="fechaNacimiento"></span></li>


      <div class="foto-perfil-container">
      <img id="foto-perfil" src="https://media1.tenor.com/m/mMLjFXdAW28AAAAd/penguin-explode.gif" alt="Foto de perfil" width="150" height="150" style="border-radius: 50%; object-fit: cover;">
      <input type="file" id="input-foto" accept="image/*">
      </div>

    </ul>
  </div>
    
  <a href="/cerrar-sesion" id="cerrar-sesion">Cerrar sesión</a>  
  <a href="/principal" class="boton-menu">Volver al menú</a> 

  <script src="/js/perfil.js"></script>

</body>
</html>
